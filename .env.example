# Copy to .env and fill in your Supabase project's public values.
# These are the PUBLIC URL + ANON key from Supabase Dashboard → Project Settings → API.
# The anon key is safe to expose in a static site because Row Level Security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
